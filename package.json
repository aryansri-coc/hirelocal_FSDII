{
  "name": "hirelocal",
  "version": "1.0.0",
  "description": "Hyperlocal Skilled & Wage Worker Marketplace with Multilingual AI CallBot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "start": "node apps/api/src/server.js",
    "dev:api": "node --watch apps/api/src/server.js",
    "dev:web": "npm --prefix apps/web run dev",
    "db:init": "node database/initPg.js",
    "db:seed": "node database/initPg.js",
    "seed": "node database/initPg.js",
    "test": "node --test apps/api/test/*.test.js"
  },
  "keywords": [
    "hyperlocal",
    "marketplace",
    "skilled-workers",
    "ai-callbot",
    "voice-first",
    "multilingual"
  ],
  "author": "HireLocal Team",
  "license": "MIT",
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
