# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Configuration
DATABASE_PATH=./database/hirelocal.db

# Authentication / JWT
JWT_SECRET=hirelocal-super-secret-development-key-32chars
JWT_EXPIRES_IN=7d
DEFAULT_DEMO_OTP=123456

# Matching Engine Configuration Weights (Must sum to ~1.0)
WEIGHT_RATING=0.30
WEIGHT_RELIABILITY=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_AVAILABILITY=0.15
WEIGHT_LOCATION_PROXIMITY=0.15

# Telephony / CallBot Provider Settings (Twilio / Mock)
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CALLBOT_WEBHOOK_URL=http://localhost:5000/api/callbot/webhook
